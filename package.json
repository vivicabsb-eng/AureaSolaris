{
  "name": "aurea-solaris",
  "private": true,
  "version": "0.1.1",
  "description": "Desktop app for astrology, personal organization, and reflective planning.",
  "author": "Aurea Solaris contributors",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "start": "npm --workspace @aurea/web run start",
    "build": "npm run build:web",
    "typecheck": "npm --workspace @aurea/web run typecheck",
    "preview": "npm --workspace @aurea/web run preview",
    "tauri": "tauri",
    "dev:full": "npm run dev:web",
    "lint": "npm --workspace @aurea/web run lint",
    "lint:fix": "npm --workspace @aurea/web run lint:fix",
    "check": "npm run check:web",
    "test": "npm run test:web",
    "test:watch": "npm --workspace @aurea/web run test:watch",
    "test:e2e": "npm --workspace @aurea/web run test:e2e",
    "dev:web": "npm --workspace @aurea/web run dev",
    "test:web": "npm --workspace @aurea/web run test",
    "build:web": "npm --workspace @aurea/web run build",
    "check:web": "npm --workspace @aurea/web run check"
  }
}
