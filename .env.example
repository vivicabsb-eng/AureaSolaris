# Aurea Solaris — Environment variables
# Copy this file to .env and fill in the real values.
# Never commit secrets to the repository.

# Core local runtime
AUREA_DATA_DIR=
AUREA_SIDECAR_TOKEN=
AUREA_SESSION_SECRET=

# Hermes provider. Choose exactly one per conversation in the interface.
# No Ollama runtime is required or probed by Hermes.
HERMES_PROVIDER=openai
HERMES_GATEWAY_URL=http://127.0.0.1:20128/v1/chat/completions
HERMES_MODEL=hermes-combo

# ChatGPT / OpenAI (required only when ChatGPT / OpenAI is selected)
OPENAI_API_KEY=
OPENAI_CHAT_URL=https://api.openai.com/v1/chat/completions
OPENAI_CHAT_MODEL=gpt-4o-mini

# Development / release paths
CARGO_TARGET_DIR=work/cargo-target-dev

# Web API (services/api)
AUREA_ENVIRONMENT=development
AUREA_SUPABASE_URL=https://example.supabase.co
AUREA_JWT_AUDIENCE=authenticated
# Secret: intentionally blank in the committed example. Supply it only in ignored/deployment env.
AUREA_DATABASE_URL=
AUREA_ALLOWED_ORIGINS=http://localhost:5173
AUREA_EPHEMERIS_PATH=./data/ephemeris
